// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  email                String   @unique
  password             String
  isActive             Boolean  @map("is_active")
  profile              Profile?
  educationLevelId     String?  @map("education_level_id")
  interestCourseId     String?  @map("interest_course_id")
  interestUniversityId String?  @map("interest_university_id")

  educationLevel       EducationLevel?     @relation(fields: [educationLevelId], references: [id])
  interestCourses      InterestCourse?     @relation(fields: [interestCourseId], references: [id])
  interestUniversities InterestUniversity? @relation(fields: [interestUniversityId], references: [id])
}

model EducationLevel {
  id   String @id @default(uuid())
  name String @unique

  User User[]

  @@map("education_level")
}

model InterestCourse {
  id   String @id @default(uuid())
  name String @unique

  User User[]

  @@map("interest_course")
}

model InterestUniversity {
  id   String @id @default(uuid())
  name String @unique

  User User[]

  @@map("interest_university")
}

enum Profile {
  MENTOR
  STUDENT
}
