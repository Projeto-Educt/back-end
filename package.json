{
  "name": "back-end",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev:build": "docker-compose up --build",
    "dev:build-d": "docker-compose up -d --build",
    "dev:kill": "docker-compose stop",
    "dev": "docker-compose up",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest --config ./jest.config.js --detectOpenHandles",
    "test:unit": "NODE_ENV=test jest --config ./jest-unit-config.js",
    "test:integration": "NODE_ENV=test jest --config ./jest-integration-config.js",
    "test:e2e": "NODE_ENV=test jest --config ./jest-e2e-config.js",
    "test:watch": "NODE_ENV=test jest --config ./jest-unit-int-config.js --watchAll --detectOpenHandles",
    "test:watch:e2e": "NODE_ENV=test jest --config ./jest-e2e-config.js --watchAll --detectOpenHandles",
    "test:cov": "NODE_ENV=test jest --config ./jest.config.js --coverage ",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky",
    "prisma:seed": "ts-node src/main/infra/repositories/prisma/seeds/index.ts",
    "prisma:init": "npx prisma generate && npx prisma migrate deploy && npm run prisma:seed",
    "start:prod": "NODE_ENV=production npm run prisma:init && node dist/nest/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.16.0",
    "dotenv": "^16.4.5",
    "express-session": "^1.18.1",
    "nodemailer": "^6.10.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "y": "^0.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@jest/environment": "^29.7.0",
    "@jest/test-sequencer": "^29.7.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.6",
    "jest": "^29.5.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.2.10",
    "pg": "^8.13.1",
    "prettier": "^3.0.0",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "schema": "./src/main/infra/repositories/prisma/schema.prisma"
  }
}